{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pacelab",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  },
  "observability": { "enabled": true },
  // Branch builds run `wrangler preview`. A Preview gets only what is listed
  // here: no AI binding and no secrets, so it can serve the page and the demo
  // but every /api and /agents route fails closed and nothing spends Workers AI.
  // Durable Objects in a Preview get their own storage, never production's.
  "previews": {},
  "durable_objects": {
    "bindings": [
      { "name": "StandardVoiceAgent", "class_name": "StandardVoiceAgent" },
      { "name": "PatientVoiceAgent", "class_name": "PatientVoiceAgent" },
      { "name": "TrialStore", "class_name": "TrialStore" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["StandardVoiceAgent", "PatientVoiceAgent", "TrialStore"]
    }
  ]
}
